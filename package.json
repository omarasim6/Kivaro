
{
  "name": "kivora-ev-ecopilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "worker": "tsx watch src/worker/index.ts",
    "dev:all": "concurrently -n web,worker -c cyan,magenta \"npm:dev\" \"npm:worker\"",
    "build": "next build",
    "start": "next start",
    "worker:prod": "tsx src/worker/index.ts",
    "start:all": "concurrently -k -n web,worker \"npm run start\" \"npm run worker:prod\""
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
